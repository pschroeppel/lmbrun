#!/usr/bin/env python3

import argparse
import os
import pickle
from lib.jobs import Jobs


def kill():
    parser = argparse.ArgumentParser()
    parser.add_argument('-p', '--path', type=str, help='path of the run that should be killed', default='.')
    parser.add_argument('--delay', help='delay for killing the job in seconds', default=300, type=int)
    args = parser.parse_args()

    current_dir = os.path.abspath(args.path)
    config_path = os.path.join(current_dir, 'last_config.pickle')
    with open(config_path, 'rb') as config_file:
        config = pickle.load(config_file)

    delay = args.delay

    j = Jobs(config)

    if delay == 0:
        j.kill()
    else:
        j.kill(delay)


if __name__ == "__main__":
    kill()
